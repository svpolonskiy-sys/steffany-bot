# Публічна адреса сайту (потрібна для canonical, sitemap, Open Graph). Без неї сайт працює як preview із noindex.
SITE_URL=

# Канал доставки звернень: URL вебхука, що приймає POST з JSON.
# Без нього форма чесно повідомляє, що надсилання не підключено.
CONTACT_WEBHOOK_URL=
# Необов'язковий секрет, який передається у заголовку Authorization: Bearer ...
CONTACT_WEBHOOK_SECRET=

# Посилання на політику конфіденційності та контакти — лише реальні значення від власника.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
